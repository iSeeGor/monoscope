# Token from https://api.monobank.ua/
MONOBANK_TOKEN=your_token_here

# Card type: white | black (default: white)
CARD_TYPE=white

# Period: full month (default: current month)
# REPORT_MONTH=2026-05

# Or custom date range (both required, overrides REPORT_MONTH)
# REPORT_FROM=2026-05-01
# REPORT_TO=2026-05-15

# Output directory for CSV and Markdown reports (default: ./output)
# OUTPUT_DIR=./output

# Include pending authorizations (hold=true). Default: true
# INCLUDE_HOLDS=false

# Web API settings
# MONOSCOPE_DB_PATH=./data/monoscope.db
# MONOSCOPE_CACHE_TTL_SECONDS=600
# MONOSCOPE_CORS_ORIGINS=http://localhost:5173
# MONOSCOPE_LOG_LEVEL=INFO
